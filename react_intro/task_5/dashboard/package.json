{
  "name": "dashboard",
  "version": "1.0.0",
  "description": "School dashboard built with Webpack, Babel and React",
  "private": true,
  "scripts": {
    "start": "webpack-dev-server --mode development --config config/webpack.config.js",
    "build": "webpack --mode production --config config/webpack.config.js",
    "test": "jest"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "react": "^16.14.0",
    "react-dom": "^16.14.0"
  },
  "devDependencies": {
    "@babel/core": "^7.12.3",
    "@babel/preset-env": "^7.12.1",
    "@babel/preset-react": "^7.12.1",
    "babel-jest": "^26.6.3",
    "babel-loader": "^8.1.0",
    "cheerio": "1.0.0-rc.3",
    "css-loader": "^3.2.0",
    "enzyme": "^3.11.0",
    "enzyme-adapter-react-16": "^1.15.8",
    "file-loader": "^5.0.2",
    "image-webpack-loader": "^6.0.0",
    "jest": "^26.6.3",
    "style-loader": "^1.0.0",
    "webpack": "^4.41.2",
    "webpack-cli": "^3.3.9",
    "webpack-dev-server": "^3.9.0"
  },
  "jest": {
    "setupFilesAfterEnv": [
      "<rootDir>/config/setupTests.js"
    ],
    "moduleNameMapper": {
      "\\.(css|less|scss)$": "<rootDir>/config/styleMock.js",
      "\\.(jpg|jpeg|png|gif|svg|ico)$": "<rootDir>/config/fileMock.js"
    }
  },
  "allowScripts": {
    "mozjpeg@6.0.1": true
  }
}
