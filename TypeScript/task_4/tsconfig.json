{
  "compilerOptions": {
    "target": "es5",
    "module": "amd",
    "lib": ["es2015", "dom"],
    "outFile": "./public/main.js",
    "noImplicitAny": true,
    "allowJs": true,
    "removeComments": true,
    "preserveConstEnums": true,
    "sourceMap": true
  },
  "include": ["js/**/*"],
  "exclude": ["node_modules", "**/*.spec.ts"]
}
